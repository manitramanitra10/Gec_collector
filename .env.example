# Copier ce fichier en .env.local et adapter la chaîne de connexion.
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
# Ne pas ajouter ?sslmode= dans l'URL : le chiffrement est piloté par DATABASE_SSL.

# --- Développement : PostgreSQL local ---
# La base est créée automatiquement par `yarn db:setup` si elle n'existe pas.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gec_collector

# --- Production : Supabase ---
# Chaîne « Transaction pooler » du tableau de bord (Project Settings > Database > Connection string).
# DATABASE_URL=postgresql://postgres.<ref-projet>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
# L'intégration Supabase <-> Vercel pose POSTGRES_URL : elle est acceptée en l'absence de DATABASE_URL.

# Chiffrement : disable (défaut si hôte local) | require (défaut sinon, fonctionne avec Supabase) | verify-full
# DATABASE_SSL=require
# Autorité de certification (PEM) pour verify-full, optionnelle.
# DATABASE_SSL_CA=

# --- Connexion Google via Auth0 (tout le site est derrière le login) ---
# Tableau de bord Auth0 > Applications > votre application (type « Regular Web Application »).
# Y déclarer : Allowed Callback URLs = <APP_BASE_URL>/auth/callback, Allowed Logout URLs = <APP_BASE_URL>.
AUTH0_DOMAIN=votre-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Secret de chiffrement du cookie de session, à générer : openssl rand -hex 32
AUTH0_SECRET=
# URL publique de l'application, sans slash final (en prod : l'URL Vercel).
APP_BASE_URL=http://localhost:3000
